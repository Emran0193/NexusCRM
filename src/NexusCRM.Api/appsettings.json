{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=nexuscrm;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "Storage": {
    "LocalRoot": "./.data/files"
  },
  "Jwt": {
    "Issuer": "NexusCRM",
    "Audience": "NexusCRM.Web",
    "SigningKey": "NexusCRM-Dev-Signing-Key-Change-In-Production-32+",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Security": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "MaxActiveRefreshTokens": 10,
    "RefreshTokenDays": 14,
    "ExposeMetricsEndpoint": false,
    "Password": {
      "MinLength": 12,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireNonAlphanumeric": true
    }
  },

  "Plugins": {
    "LoadSamples": true,
    "DefaultEnabled": true,
    "ExternalDirectory": ""
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "NexusCRM.Api",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Performance": {
    "SlowRequestThresholdMs": 500
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "OpenTelemetry": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
