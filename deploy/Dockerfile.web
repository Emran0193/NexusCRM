# syntax=docker/dockerfile:1

FROM node:22-alpine AS build
WORKDIR /web
COPY src/NexusCRM.Web/package.json src/NexusCRM.Web/package-lock.json ./
RUN npm ci
COPY src/NexusCRM.Web/ ./
# Bake API URL for containerized demos (override at build with --build-arg).
ARG API_BASE_URL=http://localhost:8080
RUN sed -i "s|apiBaseUrl: 'https://localhost:7148'|apiBaseUrl: '${API_BASE_URL}'|g" src/environments/environment.ts \
 && sed -i "s|hubUrl: 'https://localhost:7148/hubs/board'|hubUrl: '${API_BASE_URL}/hubs/board'|g" src/environments/environment.ts \
 && npm run build

FROM nginx:1.27-alpine AS final
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist/nexus-crm.web/browser /usr/share/nginx/html
EXPOSE 80
